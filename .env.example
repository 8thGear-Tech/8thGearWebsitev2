# Dedicated Neon Postgres database for this project (see prisma/schema.prisma),
# used via Prisma by the business-checkup-form Server Action.
# The pooled connection string, used by the app (src/lib/prisma.ts) at runtime.
DATABASE_URL=
DATABASE_URL_POOLED=
# The direct (unpooled) connection string, used by the Prisma CLI (prisma.config.ts)
# for `prisma migrate` / `prisma studio` / etc.
DIRECT_URL=

# Resend (https://resend.com) API key used to email the team when a Full Business
# Checkup is submitted. Leave unset to skip sending the notification email.
RESEND_API_KEY=
# Must be a sender address on a domain verified in Resend.
BUSINESS_CHECKUP_FROM_EMAIL=noreply@8thgearpartners.com
# Inbox that receives the submission notification.
BUSINESS_CHECKUP_NOTIFY_EMAIL=info@8thgearpartners.com

# Shared by every form on this site (see src/lib/formSubmissionWebhook.ts): notifies
# 8thGear Internal Tools of each submission (its /api/form-submissions route), which
# files it as a reviewable FormSubmission. Leave unset to skip calling it entirely.
FORM_SUBMISSIONS_WEBHOOK_URL=https://internal.8thgearpartners.com/api/form-submissions
# Required whenever FORM_SUBMISSIONS_WEBHOOK_URL is set, in every environment (local,
# dev, prod) — HMAC-SHA256 signs the webhook body (x-webhook-signature header). The
# receiving route now fails closed without a matching secret, so an unsigned request
# would only ever be rejected (logged, not sent). Must match FORM_SUBMISSIONS_WEBHOOK_SECRET
# on the 8thgear-int side exactly.
FORM_SUBMISSIONS_WEBHOOK_SECRET=
